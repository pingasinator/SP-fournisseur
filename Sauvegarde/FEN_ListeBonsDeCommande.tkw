     name : ListerCommandes
     procedure_id : 1890364846805836890
     type_code : 14
     code : |1-
      //!
      //! @brief <indiquez ici ce que fait la procédure>
      //!
      //!
      
      procédure ListerCommandes()
      
      sdCommande est une source de données
      sql est une chaîne
      
      TableSupprimeTout(TABLE_Commandes)
      
      sql = "SELECT Commandes.id, Fournisseurs.raisonSociale,Commandes.montantTotalHt FROM Commandes INNER JOIN Fournisseurs ON Commandes.fournisseur_id = Fournisseurs.id"
      
      HExécuteRequêteSQL(sdCommande,sq)
     type : 458752
