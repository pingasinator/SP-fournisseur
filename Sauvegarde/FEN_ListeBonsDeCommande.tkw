  procedures :
   -
     name : ListerCommandes
     procedure_id : 1890364846805836890
     type_code : 14
     code : |1-
      //!
      //! @brief <indiquez ici ce que fait la procédure>
      //!
      //! @param mode  <indiquez ici le rôle de mode>
      //!
      //!
      
      procédure ListerCommandes(mode)
      
      sdCommande est une source de données
      sql est une chaîne
      
      TableSupprimeTout(TABLE_Commandes)
      
      sql = [
      		SELECT Commandes.id as commande_id, 
      		Fournisseurs.raisonSociale as raisonSociale,
      		Commandes.montantTotalHt as montantTotalHT 
      		FROM Commandes INNER JOIN Fournisseurs ON Commandes.fournisseur_id = Fournisseurs.id
      		WHERE %1
      ]
      
      selon mode
      	CAS 1
      		sql = ChaîneConstruit(sql,"Commandes.receptionnee = 0")
      	CAS 2
      		sql = ChaîneConstruit(sql,"Commandes.livree = 0")
      	cas 3
      		sql =  ChaîneConstruit(sql,"Commandes.receptionnee = 1 AND Commandes.livree = 1 ")
      FIN
      
      si pas HExécuteRequêteSQL(sdCommande,sql) alors
      	Erreur("Erreur d'initialisation de la requête" + RC +HErreurInfo())
      	retour
      fin
      
      HLitPremier(sdCommande)
      si HTrouve(sdCommande) alors
      	tantque  HEnDehors(sdCommande) = Faux
      
      		TableAjoute(TABLE_Commandes,sdCommande.commande_id + TAB + sdCommande.raisonSociale + TAB + sdCommande.montantTotalHT)
      		HLitSuivant(sdCommande)
      	fin
      sinon
      	Info("Aucune commande finalisé.")
      
      fin
     type : 458752
   -
     name : chargerCommande
     procedure_id : 1890634751050815907
     type_code : 14
     code : |1-
      //!
      //! @brief <indiquez ici ce que fait la procédure>
      //!
      //! @param commande_id  id  <indiquez ici le rôle de id>
      //!
      //!
      
      procédure chargerCommande(commande_id)
      
      sql est une chaine
      sdCommande est une source de données
      
      TableSupprimeTout(TABLE_LigneCommandes)
      
      sql = [
      	SELECT Commandes.id as commande_id,
      		Commandes.dateDeCommande as dateDeCommande,
      		Commandes.fournisseur_id as fournisseur_id,
      		Fournisseurs.raisonSociale as raisonSociale,
       		Commandes.montantTotalHt as montantTotalHT,
       		Commandes.receptionnee as receptionnee,
      		Commandes.dateDeReception as dateDeReception,
      		Commandes.dateDeCreation as dateDeCreation,
      		Commandes.dateDeDerniereModification as dateDeModification
      		FROM Commandes INNER JOIN Fournisseurs ON Commandes.fournisseur_id = Fournisseurs.id 
       	WHERE Commandes.id = %1 
       ]
      
      sql = ChaîneConstruit(sql,commande_id)
      
      si pas HExécuteRequêteSQL(sdCommande,sql) ALORS
      	Erreur("Erreur d'initialisation de la requête" + RC +HErreurInfo())
      FIN
      
      HLitPremier(sdCommande)
      si HTrouve(sdCommande) ALORS
      	SAI_DateDeCommande = sdCommande.dateDeCommande
      	SAI_Fournisseur_id = sdCommande.fournisseur_id
      	SAI_RaisonSociale = sdCommande.raisonSociale
      	INT_Receptionnee = sdCommande.receptionnee
      	SAI_MontantTotalHt = sdCommande.montantTotalHT
      	SAI_DateDeReception =  DateVersChaîne(sdCommande.dateDeReception)
      	LIB_FicheCree = "Fiche crée le : " + DateVersChaîne(sdCommande.dateDeCreation)
      	LIB_FicheModifie = "Fiche modifiée le : " + DateVersChaîne(sdCommande.dateDeModification)
      	listerLigneCommande(commande_id)
      sinon
      	Avertissement("Commande introuvable")
      FIN
     type : 458752
   -
     name : listerLigneCommande
     procedure_id : 1890696894970486473
     type_code : 14
     code : |1-
      //!
      //! @brief <indiquez ici ce que fait la procédure>
      //!
      //! @param commande_id  <indiquez ici le rôle de commande_id>
      //!
      //!
      
      procédure listerLigneCommande(commande_id)
      
      cpt est un entier
      sql est une chaine
      sdLigneCommande est une source de données
      
      TableSupprimeTout(TABLE_LigneCommandes)
      
      cpt = 0
      
      sql = [
      		SELECT Produits.reference AS reference,
      		Produits.codeProduitFournisseur AS codeProduitFournisseur,
       		Produits.id AS produit_id,
      		Produits.designation AS designation,
      		Produits.quantite AS quantite,
      		Produits.prixUnitaireHt AS prixUnitaireHt,
      		LignesCommandes.montantHt AS montantHt
      		FROM LignesCommandes INNER JOIN Produits ON Produits.id = LignesCommandes.produit_id
      		Where commande_id = %1
      ]
      
      sql = ChaîneConstruit(sql,commande_id)
      
      si pas HExécuteRequêteSQL(sdLigneCommande,sql) ALORS
      	Erreur("Erreur d'initialisation de la requête" + RC +HErreurInfo())
      fin
      
      HLitPremier(sdLigneCommande)
      si HTrouve(sdLigneCommande) ALORS
      	tantque HEnDehors(sdLigneCommande) = Faux
      		TableAjoute(TABLE_LigneCommandes,sdLigneCommande.reference + TAB + sdLigneCommande.codeProduitFournisseur + TAB + sdLigneCommande.designation + TAB + sdLigneCommande.quantite + TAB + sdLigneCommande.quantite + TAB + sdLigneCommande.montantHt)
      		cpt++
      		HLitSuivant(sdLigneCommande)
      	FIN
      	SAI_NBCommande = cpt
      sinon
      	Avertissement("Il n'y a aucun produits sur cette commande")
      FIN
     type : 458752
