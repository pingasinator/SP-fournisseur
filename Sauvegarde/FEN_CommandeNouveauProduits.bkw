  procedures :
   -
     name : chargerListeProduits
     procedure_id : 1892582480073061993
     type_code : 14
     code : |1+
      //!
      //! @brief <indiquez ici ce que fait la procédure>
      //!
      //!
      procédure chargerListeProduits()
      
      TableSupprimeTout(TABLE_Fournisseurs)
      
      sdProduits	est une Source de Données
      sql			est une chaîne
      
      sql = [
      	
      	SELECT
      	Fournisseurs.id as id,
      	Fournisseurs.raisonSociale as raisonSociale,
      	COUNT(Produits.id) as nbProduits
      	FROM Produits LEFT OUTER JOIN LignesCommandes ON LignesCommandes.produit_id != Produits.id LEFT INNER JOIN Fournisseurs ON Fournisseurs.id = Produits.fournisseur_id
      	WHERE LignesCommandes.produit_id != Produits.id 
      	GROUP BY Fournisseurs.id, Fournisseurs.raisonSociale
      ]
      
      si pas HExécuteRequêteSQL(sdProduits,sql) alors
      	Erreur("Erreur d'initialisation de la requête" + RC +HErreurInfo())
      	retour
      fin
      
      HLitPremier(sdProduits)
      si HTrouve(sdProduits) alors
      	tantque HEnDehors(sdProduits) = Faux
      		TableAjoute(TABLE_Fournisseurs, sdProduits.id + TAB + sdProduits.raisonSociale + TAB + sdProduits.nbProduits)
      		HLitSuivant(sdProduits)
      	fin
      fin
      
     type : 458752
   -
     name : chargerCommande
     procedure_id : 1892583339067441902
     type_code : 14
     code : |1-
      //!
      //! @brief <indiquez ici ce que fait la procédure>
      //!
      //! @param idFournisseur  <indiquez ici le rôle de idFournisseur>
      //!
      //!
      
      procédure chargerCommande(idFournisseur)
      
      sdCommande est une source de données
      sql est une chaîne
      
      TableSupprimeTout(TABLE_ligneCommandes)
      
      sql = [
      	SELECT Produits.id AS id,
      	Produits.reference AS reference,
      	Produits.codeProduitFournisseur AS codeProduitFournisseur,
      	Produits.designation AS designation,
      	Produits.quantite AS quantite,
      	Produits.prixUnitaireHt AS prixUnitaireHt,
      	Produits.Fournisseur_id,
      	Fournisseurs.raisonSociale AS raisonSociale
      	FROM Produits LEFT JOIN Fournisseurs ON Fournisseurs.id = Produits.fournisseur_id
      	WHERE Produits.Fournisseur_id = %1
      ]
      
      sql = ChaîneConstruit(sql,idFournisseur)
      
      si pas HExécuteRequêteSQL(sdCommande,sql) ALORS
      	Erreur("Erreur d'initialisation de la requête" + RC +HErreurInfo())
      	retour
      FIN
      
      HLitPremier(sdCommande)
      si HTrouve(sdCommande) ALORS
      	SAI_Fournisseur_id	= sdCommande.Fournisseur_id
      	SAI_RaisonSociale	= sdCommande.raisonSociale
      	tantque HEnDehors(sdCommande) = faux
      		TableAjoute(TABLE_ligneCommandes, sdCommande.reference + TAB + sdCommande.codeProduitFournisseur + TAB + sdCommande.designation + TAB + 120 + TAB + sdCommande.prixUnitaireHt + TAB + COL_Quantite * sdCommande.prixUnitaireHt)
      		HLitSuivant(sdCommande)
      	FIN
      FIN
      
      SAI_DateDeCommande = DateDuJour()
