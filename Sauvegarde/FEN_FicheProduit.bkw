      -
        code : |1+
         // Version 1
         // Description
         // Bouton en validation
         
        type : 14
      -
        code : |1+
         
         INT_Epuise.Grisé = vrai
         SAI_Information.Grisé = vrai
         BTN_Valider.Visible = faux
         BTN_Modifier.Visible = vrai
         
         Produits.LitRecherchePremier(id,id)
         si Produits.Trouve() alors
         	FEN_FicheProduit.VersTable(Produits)
         	Produits.Modifie(id)
         	FEN_ListeProduits.chargeListeProduits()
         fin
         
        type : 18
