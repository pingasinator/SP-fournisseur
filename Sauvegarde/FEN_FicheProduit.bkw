  -
    name : BTN_Supprimer
    identifier : 0x2a3b8d9d0cc38939
    internal_properties : 
    properties :
     x : 253
     y : 563
     width : 102
     height : 24
     accelerator_key : 46
     tab_order : 12
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         // Version 1
         // Description
         // Bouton au style Supprimer
         
         
        type : 14
      -
        code : |1+
         
         HLitRecherchePremier(Produits,id,id)
         si Htrouve(Produits) ALORS
         	ÉcranVersFichier(FEN_FicheProduit,Produits)
         	si HSupprime(Produits) ALORS
         		Info("Le produit " + SAI_Designation + " à été correctement supprimé")
         	sinon
         		Avertissement("Le produit avec l'ID " + id + " n'a pas été trouvé")
         	FIN
         
         	FEN_ListeProduits.chargeListeProduits()
         	Ferme(FEN_FicheProduit)
         
         sinon
         	Avertissement("Le produit avec l'ID " + id + " n'a pas été trouvé")
         FIN
        type : 18
      -
        type : 161
        enabled : false
