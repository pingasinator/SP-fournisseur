     type : 2
  procedures :
   -
     name : chargerCommande
     procedure_id : 1893675734067705797
     type_code : 14
     code : |1-
      //!
      //! @brief <indiquez ici ce que fait la procédure>
      //!
      //!
      procédure chargerCommande()
      
      montantTotalHt est un entier
      montantTotalHt = 0
      
      SAI_DateDeCommande = DateDuJour()
      
      SAI_RaisonSociale = COL_RaisonSociale
      
      pour toute ligne de TABLE_Produits
      	si COL_RaisonSociale = SAI_RaisonSociale alors
      
      	HLitRecherchePremier(Produits,reference,COL_Reference)
      		si HTrouve(Produits) ALORS
      			TableAjoute(TABLE_ligneCommandes,COL_Reference + TAB + Produits.codeProduitFournisseur + TAB + TABLE_Produits.COL_Designation + TAB + COL_ACommander + TAB + Produits.prixUnitaireHt + TAB + Produits.prixUnitaireHt * COL_ACommander)
      			montantTotalHt += Produits.prixUnitaireHt * COL_ACommander
      		FIN
      	fin
      FIN
      
      SAI_MontantTotalHt = montantTotalHt
     type : 458752
