  procedures :
   -
     name : chargerListeProduits
     procedure_id : 1893675734067705797
     type_code : 14
     code : |1-
      //!
      //! @brief <indiquez ici ce que fait la procédure>
      //!
      //!
      procédure chargerListeProduits()
      
      requete	est un httpRequête
      reponse	est un httpRéponse
      
      données	est un tableau de chaînes
      
      requete.URL	= "https://sp-vendeurs.yajil.dev-campus.fr/mvc-sp/api/Windev.php?action=get_commandes&wDemande=azerty2QWERTY"
      
      reponse		= requete.Envoie()
      
      TABLE_Produits.SupprimeTout()
      
      si ErreurDétectée alors
      	Erreur(ErreurInfo(errComplet))
      sinon
      	données = ChaîneDécoupe(reponse.Contenu," sep ")
      	données.Supprime(DernierElément)
      	pour toute Indice de données
      		valeurs est un tableau de chaînes
      		valeurs = Indice.Découpe(" ; ")
      
      		sdFournisseurs	est une Source de Données
      		sql				est une chaîne
      
      		sdCheck est une source de données
      
      		sql = [
        	  	  	 SELECT
       				COUNT(Commandes.id) AS nbCommandes
      			 FROM Produits
      				LEFT OUTER JOIN	LignesCommandes	ON LignesCommandes.produit_id = Produits.id
      				RIGHT JOIN Commandes ON Commandes.id = LignesCommandes.commande_id
      			 WHERE
      				Commandes.receptionnee = 0 AND
      				Produits.codeProduitFournisseur = %1
      		]
      
      		sql = ChaîneConstruit(sql,valeurs[2])
      		sdCheck.ExécuteRequêteSQL(sql)
      		sdCheck.LitPremier()
      		si sdCheck.Trouve() ALORS
      
      			si sdCheck.nbCommandes > 0 ALORS
      				continuer
      			FIN
      		FIN
      
      		// initialise les données dans la table
      		sql = [
      			SELECT Fournisseurs.id as idFournisseur,
      			Produits.id as idProduits,
      			raisonSociale
      			FROM Fournisseurs
      			RIGHT JOIN Produits ON Produits.Fournisseur_id = Fournisseurs.id
      			WHERE
      			Produits.codeProduitFournisseur = %1
      		]
      
      		sql = ChaîneConstruit(sql, valeurs[2])
      
      		sdFournisseurs.ExécuteRequêteSQL(sql)
      		sdFournisseurs.LitPremier()
      		si sdFournisseurs.Trouve() alors
      			TABLE_Produits.Ajoute(sdFournisseurs.idFournisseur + TAB + sdFournisseurs.idProduits + TAB + sdFournisseurs.raisonSociale + TAB + valeurs[1] + TAB + valeurs[2] + TAB + valeurs[3] + TAB + valeurs[4])
      		fin
      	fin
      fin
     type : 458752
   -
     name : resetBonCommande
     procedure_id : 1897337726325356391
     type_code : 14
     code : |1+
      //!
      //! @brief Réinitialise le bon de commande
      //!
      //!
      procédure resetBonCommande()
      
      SAI_DateDeCommande = ""
      SAI_Fournisseur_id = ""
      SAI_MontantTotalHt = ""
      SAI_RaisonSociale = ""
      
      TABLE_ligneCommandes.SupprimeTout()
      
     type : 458752
   -
     name : validerBonCommande
     procedure_id : 1897382930861297355
     type_code : 14
     code : |1+
      //!
      //! @brief <indiquez ici ce que fait la procédure>
      //!
      //!
      procédure validerBonCommande()
      
      numLigne est un entier
      numLigne = 1
      
      FEN_CommandeProduits.VersTable(Commandes)
      
      si verifierBonCommande() alors
      	//Ajoute la commande en base de données
      	Commandes.Ajoute()
      
      	//Ajout des lignes de la commande en base de données
      	pour toute ligne de TABLE_ligneCommandes
      		LignesCommandes.commande_id			= Commandes.id
      		LignesCommandes.numeroDeLigne		= numLigne
      		LignesCommandes.quantiteCommandee	= COL_Quantite
      		LignesCommandes.montantHt			= COL_Montant_HT
      		LignesCommandes.produit_id			= COL_ProduitID
      		LignesCommandes.Ajoute()
      		numLigne++
      	fin
      
      	Info("Le Bon de commande N°" + Commandes.id + " a correctement été généré.")
      
      	chargerListeProduits()
      	resetBonCommande()
      fin
      
      
      
     type : 458752
   -
     name : verifierBonCommande
     procedure_id : 1898122528571008199
     type_code : 14
     code : |1-
      //!
      //! @brief vérifie les donnée du bon de commande
      //!
      //! @return (booléen)  <indiquez ici les valeurs possibles ainsi que leur interprétation>
      //!
      //!
      
      procédure verifierBonCommande()
      
      si TABLE_ligneCommandes.Occurrence() = 0 ALORS
      	retour faux
      sinon
      	si SansEspace(SAI_Fournisseur_id) = "0" ou SAI_Fournisseur_id  = "0" alors
      		retour Faux
      	fin
      fin
      
      retour vrai
     type : 458752
   -
     name : chargerCommande
     procedure_id : 1898144578944268847
     type_code : 14
     code : |1-
      //!
      //! @brief <indiquez ici ce que fait la procédure>
      //!
      //!
      procédure chargerCommande()
      
      montantTotalHt est un entier
      montantTotalHt = 0
      
      TABLE_ligneCommandes.SupprimeTout()
      
      SAI_DateDeCommande = DateDuJour()
      
      SAI_Fournisseur_id = COL_idFournisseur
      SAI_RaisonSociale = COL_RaisonSociale
      
      pour toute ligne de TABLE_Produits
      	si COL_RaisonSociale = SAI_RaisonSociale alors
      
      	Produits.LitRecherchePremier(id,COL_idProduit)
      		si Produits.Trouve() ALORS
      			TABLE_ligneCommandes.Ajoute(Produits.id + TAB + Produits.reference + TAB + Produits.codeProduitFournisseur + TAB + TABLE_Produits.COL_Designation + TAB + COL_ACommander + TAB + Produits.prixUnitaireHt + TAB + Produits.prixUnitaireHt * COL_ACommander)
      			montantTotalHt += Produits.prixUnitaireHt * COL_ACommander
      		FIN
      	fin
      FIN
      
      SAI_MontantTotalHt = montantTotalHt
     type : 458752
