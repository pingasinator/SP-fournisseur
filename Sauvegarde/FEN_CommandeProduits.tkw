 code_elements :
  type_code : 1
  p_codes :
   -
     code : |1-
      PROCEDURE MaFenêtre()
      
      requete est un httpRequête
      reponse est un httpRéponse
      
      données est un tableau de chaînes
      
      requete.URL = "https://sp-vendeurs.yajil.dev-campus.fr/mvc-sp/api/wCommandeHttp.php?wDemande=azerty2QWERTY"
      
      Reponse = HTTPEnvoie(requete)
      
      TableSupprimeTout(TABLE_Produits)
      
      SI ErreurDétectée ALORS
      	Erreur(ErreurInfo(errComplet))
      SINON
      	données = ChaîneDécoupe(reponse.Contenu," sep ")
      	données.Supprime(DernierElément)
      	pour toute Indice de données
      		valeurs est un tableau de chaines
      		valeurs = ChaîneDécoupe(Indice," ; ")
      
      		sdFournisseurs est une source de données
      		sql est une chaine
      		sql = [
        	  	  	  SELECT raisonSociale FROM Fournisseurs RIGHT JOIN Produits ON Produits.Fournisseur_id = Fournisseurs.id WHERE Produits.reference = %1
      		]
      
      		SQL = ChaîneConstruit(sql, valeurs[2])
      
      		HExécuteRequêteSQL(sdFournisseurs,sql)
      		HLitPremier(sdFournisseurs)
      		TableAjoute(TABLE_Produits,sdFournisseurs.raisonSociale + TAB + valeurs[1] + TAB + valeurs[2] + TAB + valeurs[3] + TAB + valeurs[4])
      	fin
      FIN
   -
     code : |1+
      
      
     type : 34
   -
     code : |1+
      
      
     type : 234
   -
     code : |1+
      
      
     type : 165
