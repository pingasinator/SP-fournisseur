 controls :
  -
    name : SAI_Fichier
    identifier : 0x2a3a75c91061f04d
    internal_properties : 
    properties :
     x : 35
     y : 21
     width : 542
     height : 24
     caption :
      fr-FR : Fichier
     accelerator_key : 65535
     tab_order : 0
    type : 2
    code_elements :
     type_code : 3
     p_codes :
      -
        code : |1-
         // Version 1
         // Description
         // Saisie d'un chemin de fichier
        type : 14
      -
        type : 276
        enabled : false
      -
        type : 277
        enabled : false
      -
        type : 278
        enabled : false
      -
        type : 338
        enabled : false
      -
        type : 339
        enabled : false
      -
        code : |1+
         sFichier est une chaîne
         
         // Ouvre le sélecteur de fichiers
         soit sCheminOuverture = fExtraitChemin(SAI_Fichier,fDisque+fRépertoire)
         soit sFichierInitial = fExtraitChemin(SAI_Fichier,fFichier+fExtension)
         soit sTitre=<§R1a3a75c90102f05c¤fr-FR¤Sélectionner un fichier...¤en-GB¤Select a file...¤es-ES¤Seleccionar un archivo...¤0§>
         soit sFiltre=<§R1a3a75c90103f05c¤fr-FR¤Tous fichiers (*.*)¤en-GB¤All files (*.*)¤es-ES¤Todos los archivos (*.*)¤0§>+TAB+"*.*"
         // ouvre le sélecteur
         sFichier = fSélecteur(sCheminOuverture, sFichierInitial, sTitre, sFiltre, "", fselOuvre + fselExiste)
         
         SI sFichier<>"" ALORS 
         	SAI_Fichier =  sFichier
         	ExécuteTraitement(SAI_Fichier,trtModification)
         FIN
         
        type : 336
  -
    name : BTN_IMPORTER
    identifier : 0x2a3a75ff1378c437
    internal_properties : 
    properties :
     x : 669
     y : 21
     width : 80
     height : 24
     accelerator_key : 65535
     tab_order : 1
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         // Version 1
         // Description
         // Bouton simple
         
        type : 14
      -
        code : |1-
         
         // Programme :
         // Importe un fichier xlsx (de manière générique) de produits fournisseurs vers la base de données
         // puis affiche le catalogue complet de produits par date de création décroissante
         
         // Déclaration de variable
         
         fichierProduit est un xlsDocument 			// Document Excel en lecture
         nombreDeLignes est un entier 				// Nombre de lignes au sein du fichier excel
         ext est une chaine 							// Récupération de l'extension du fichier à lire
         nomFichier est une chaîne ANSI 			// Récupération du nom de fichier
         i est un entier								// Position dans le fichier
         b est un booléen							// Contrôle de l'extension
         nomFournisseur est une chaîne				// Raison sociale du fournisseur
         cpt est un entier							// Compte le nombre de produits ajoutés en BD
         cptMod est un booléen						//  Indique si des produits ont eu un tarif modifié
         kComposee est un buffer 					// Création de la clé pour contrôle existence du produit à importer en BD
         infoModificationTarifaire est une chaîne	// Information sur l'évolution des tarifs
         
         // Initialisation des variables
         i = 2 // Se positionner sur la seconde ligne du tableau Excel
         cpt = 0
         cptMod = 0
         infoModificationTarifaire = "Le ou les produits suivant ont vu une évolution des tarifs : " + RC;
         LIB_MessageListeProduits = ""
         
         TableSupprimeTout(TABLE_ListeProduits) //Initialisation de la table
         
         si SAI_Fichier = "" alors
         	LIB_MessageListeProduits.Couleur = RougeClair
         	LIB_MessageListeProduits.PoliceGras = Vrai
         	LIB_MessageListeProduits = "Veuillez choisir le fichier à importer."
         	chargeListeProduits()
         	RepriseSaisie(SAI_Fichier)
         
         FIN
         
         ext = fExtraitChemin(SAI_Fichier,fExtension)
         b = (ext <> ".xlsx" et ext <> ".xls" et ext <> ".csv")
         
         si b ALORS
         	LIB_MessageListeProduits.Couleur = RougeClair
         	LIB_MessageListeProduits.PoliceGras =  Vrai
         	LIB_MessageListeProduits = "Le format de fichier est : " + ext + " " + RC + "ce n'est pas celui attendu. Seules sont autorisés les extensions  .xlsx, .xls ou .csv"
         	RepriseSaisie(SAI_Fichier)
         fin
         
         nomFichier = fExtraitChemin(SAI_Fichier,fFichier)
         si Taille(nomFichier) > 31 alors
         LIB_MessageListeProduits.Couleur	= RougeClair
         LIB_MessageListeProduits.PoliceGras	= Vrai
         LIB_MessageListeProduits			= "L nom de la feuille doit comprendre entre 1 et 31 caractères maximum"
         RepriseSaisie(SAI_Fichier)
         FIN
         
         fichierProduit = xlsOuvre(SAI_Fichier)
         
         si ErreurDétectée ou fichierProduit = NULL alors
         	Erreur(ErreurInfo())
         FIN
         
         nombreDeLignes = xlsNbLigne(fichierProduit)
         
         si nombreDeLignes < 2 ALORS
         	info("Le fichier importé est vide")
         	RepriseSaisie(SAI_Fichier)
         sinon
         
         	tantque i < nombreDeLignes
         		// Vérification que le produit fournisseur en cours d'importation n'existe pas en BD
         		kComposee = HConstruitValClé(Produits,fournisseuridCodeProduitFournisseur,fichierProduit[i,1],fichierProduit[i,2])
         		HLitRecherchePremier(Produits,fournisseuridCodeProduitFournisseur,kComposee)
         		si HTrouve(Produits) = Faux alors
         			Produits.reference = fichierProduit[i,1]+""+fichierProduit[i,2]
         			Produits.designation = Majuscule(fichierProduit[i,3])
         			Produits.quantite = fichierProduit[i,4]
         			Produits.descriptif = fichierProduit[i,5]
         			Produits.prixUnitaireHt = fichierProduit[i,6]
         			Produits.poidsPiece = fichierProduit[i,7]
         			Produits.epuise = faux
         			Produits.codeProduitFournisseur = fichierProduit[i,2]
         			Produits.Fournisseur_id = fichierProduit[i,1]
         			HAjoute(Produits)
         			cpt++
         		sinon
         			si Produits.prixUnitaireHt <> fichierProduit[i,6] ALORS
         				Produits.prixUnitaireHt = fichierProduit[i,6]
         				infoModificationTarifaire = infoModificationTarifaire + " - " + Majuscule(fichierProduit[i,3]) + RC
         				cptMod = 1
         				HModifie(Produits)
         			FIN
         
         		FIN
         
         		i++
         	FIN
         
         	si cpt = 0 alors
         		LIB_MessageListeProduits.Couleur = RougeClair
         		LIB_MessageListeProduits.PoliceGras = VRAI
         		LIB_MessageListeProduits = "Le fichier a été correctement parcouru mais aucun produit nouveau n'a été ajouté "
         	sinon
         		si cpt = 1 ALORS
         			LIB_MessageListeProduits = "Le fichier à correctement été importé avec " + cpt + "nouveau produit."
         
         		sinon
         			LIB_MessageListeProduits = "Le fichier à correctement ét importé avec " + cpt + "nouveau produits."
         		FIN
         		LIB_MessageListeProduits.Couleur = VertFoncé
         		LIB_MessageListeProduits.PoliceGras = vrai
         	FIN
         
         	xlsFerme(fichierProduit)
         
         	// Réafficher le catalogue
         	chargeListeProduits()
         
         	si cptMod = 1 ALORS
         		info(infoModificationTarifaire)
         	FIN
         FIN
        type : 18
      -
        type : 161
        enabled : false
