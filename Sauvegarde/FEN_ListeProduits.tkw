     name : chargeListeProduits
     procedure_id : 1889961575075884597
     type_code : 14
     code : |1+
      //!
      //! @brief <indiquez ici ce que fait la procédure>
      //!
      //!
      procédure chargeListeProduits()
      // Déclaration
      sdReqCatalogue est une Source de Données
      sQL est une chaîne
      nCpt est un entier
      sTxtEpuise est une chaine // Ecrire le terme "Epuisé"
      
      // Initialisation
      
      sQL = "SELECT Produits.id as codeProduit, reference, designation, prixUnitaireHt, epuise, codeProduitFournisseur, Fournisseurs.id as codeFournisseur, raisonSociale, Produits.dateDeCreation " +
      "FROM Produits INNER JOIN Fournisseurs ON Fournisseurs.id = Produits.Fournisseur_id " +
      " ORDER BY Produits.dateDeCreation DESC"
      
      nCpt = 0
      sTxtEpuise = " - "
      
      TableSupprimeTout(TABLE_ListeProduits)
      
      si pas HExécuteRequêteSQL(sdReqCatalogue,sQL) alors
      	Erreur("Erreur d'initialisation de la requête" + RC +HErreurInfo())
      	retour
      fin
      
      // Début
      HLitPremier(sdReqCatalogue)
      si HTrouve(sdReqCatalogue) ALORS
      	tantque  HEnDehors(sdReqCatalogue) = faux
      		si sdReqCatalogue.epuise = 1 alors
      			sTxtEpuise = "Epuisé"
      		fin
      	TableAjoute(TABLE_ListeProduits,sdReqCatalogue.codeProduit + TAB + sdReqCatalogue.reference + TAB + sdReqCatalogue.designation + TAB + sdReqCatalogue.prixUnitaireHt +TAB + sTxtEpuise + TAB  + sdReqCatalogue.codeProduitFournisseur + TAB + sdReqCatalogue.codeFournisseur + TAB + sdReqCatalogue.raisonSociale)
      	nCpt++
      	sTxtEpuise = " - "
      	HLitSuivant(sdReqCatalogue)
      	fin
      	LIB_NombreProduits = "Nombre de Produits : " + nCpt
      sinon
      	Info("Le fichier est vide.")
      	LIB_NombreProduits = "Nombre de Produits : 0"
      FIN
      
      
      // Fin
     type : 458752
  procedure_templates : []
  property_templates : []
