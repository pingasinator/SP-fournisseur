  procedures :
   -
     name : chargementFicheProduit
     procedure_id : 1890261750326501269
     type_code : 14
     code : |1+
      //!
      //! @brief <indiquez ici ce que fait la procédure>
      //!
      //!
      procédure chargementFicheProduit()
      
      sdFournisseur est une source de données
      sql est une chaîne
      
      Produits.LitRecherchePremier(id,id)
      si Produits.Trouve() = Vrai alors
      	FEN_FicheProduit.DepuisTable()
      
      	sql = "SELECT raisonSociale FROM Fournisseurs WHERE id = %1"
      	sql = ChaîneConstruit(sql,SAI_Fournisseur_id)
      	sdFournisseur.ExécuteRequêteSQL(sql)
      	SAI_RaisonSociale = sdFournisseur.raisonSociale
      
      	LIB_DateCreation		= "Fiche créée le : " + " " + DateVersChaîne(Produits.dateDeCreation?? "JJJJ JJ MMM AAAA")
      	LIB_DateModification	= "Fiche modifiée le : " + " " + DateVersChaîne(Produits.dateDeDerniereModification?? "JJJJ JJ MMM AAAA")
      sinon
      	Info("Enregistrement non trouvé")
      fin
     type : 458752
  procedure_templates : []
  property_templates : []
