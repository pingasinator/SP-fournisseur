  -
    name : BTN_Valider
    identifier : 0x2a3b91271cf659e8
    internal_properties : 
    properties :
     x : 584
     y : 621
     width : 82
     height : 24
     visible : 0
     accelerator_key : 65535
     tab_order : 14
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         // Version 1
         // Description
         // Bouton en validation
         
        type : 14
      -
        code : |1+
         
         INT_Epuise.Grisé = vrai
         SAI_Information.Grisé = vrai
         BTN_Valider.Visible = faux
         BTN_Modifier.Visible = vrai
         
         Produits.LitRecherchePremier(id,id)
         si Produits.Trouve() alors
         	req est une source de données
         	sql est une chaîne
         	sql = [
          	 	 UPDATE Produits SET epuise = %1, information = '%2' WHERE reference = %3
         	]
         	FEN_FicheProduit.VersTable(Produits)
         	sql = ChaîneConstruit(sql,Produits.epuise,Produits.information,Produits.reference)
         	req.ExécuteRequêteSQL(sql)
         	FEN_ListeProduits.chargeListeProduits()
         fin
         
        type : 18
      -
        type : 161
        enabled : false
